rules_version = '2';

// Firestore security rules (NFR-007). See docs/data-model.md.
//
// Any collection without a rule here is blocked.
// Add a rule before using a new collection.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDocumentOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function currentUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    // Demo tutors created by scripts/seedTutors.js.
    function isSeededDemoAccount() {
      let email = request.auth.token.get("email", "");
      return email is string
        && (
          email == "rachel.lim@tutorlah.test"
          || email == "daniel.ng@tutorlah.test"
          || email == "priya.kumar@tutorlah.test"
          || email == "weijie.tan@tutorlah.test"
          || email == "aisyah.rahman@tutorlah.test"
          || email == "marcus.lee@tutorlah.test"
        );
    }

      match /matches/{matchId} {
    function hasRequiredIds(data) {
      return data.keys().hasAll([
        "senderId",
        "recipientId",
        "studentId",
        "tutorId"
      ]);
    }

    function hasValidIdTypes(data) {
      return data.senderId is string
        && data.recipientId is string
        && data.studentId is string
        && data.tutorId is string;
    }

    function hasValidParticipants(data) {
      return hasRequiredIds(data)
        && hasValidIdTypes(data)
        && data.studentId != data.tutorId
        && (
          (
            data.senderId == data.studentId
            && data.recipientId == data.tutorId
          )
          ||
          (
            data.senderId == data.tutorId
            && data.recipientId == data.studentId
          )
        );
    }

    function isParticipant(data) {
      return isSignedIn()
        && (
          request.auth.uid == data.studentId
          || request.auth.uid == data.tutorId
          || request.auth.uid == data.senderId
          || request.auth.uid == data.recipientId
        );
    }

    function hasAllowedRequestFields(data) {
      return data.keys().hasOnly([
          "status",
          "senderId",
          "recipientId",
          "studentId",
          "tutorId",
          "assignmentId",
          "studentFirstName",
          "studentLastName",
          "tutorFirstName",
          "tutorLastName",
          "subject",
          "level",
          "createdAt",
          "updatedAt"
        ])
        && data.tutorFirstName is string
        && data.tutorLastName is string
        && data.get("studentFirstName", "") is string
        && data.get("studentLastName", "") is string
        // FR-009: the subject and level the student wants (optional).
        && data.get("subject", "") is string
        && data.get("subject", "").size() <= 200
        && data.get("level", "") is string
        && data.get("level", "").size() <= 50;
    }

    function hasAuthoritativeTutorName(data) {
      let tutor = get(
        /databases/$(database)/documents/tutorProfiles/$(data.tutorId)
      ).data;
      return data.tutorFirstName == tutor.firstName
        && data.tutorLastName == tutor.lastName;
    }

    function hasAuthoritativeStudentName(data) {
      let student = get(
        /databases/$(database)/documents/users/$(data.studentId)
      ).data;
      return data.studentFirstName == student.firstName
        && data.studentLastName == student.lastName;
    }

    function hasFinishedProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.onboardingComplete == true;
    }

    function isDirectTutorRequest(id, data) {
      return !("assignmentId" in data)
        && data.senderId == data.studentId
        && id == data.studentId + "_" + data.tutorId
        && currentUserRole() == "student"
        && hasAuthoritativeStudentName(data)
        && hasAuthoritativeTutorName(data)
        && exists(
          /databases/$(database)/documents/tutorProfiles/$(data.tutorId)
        );
    }

    function isAssignmentApplication(id, data) {
      return "assignmentId" in data
        && data.assignmentId is string
        && data.senderId == data.tutorId
        && id == data.assignmentId + "_" + data.tutorId
        && currentUserRole() == "tutor"
        && !("studentFirstName" in data)
        && !("studentLastName" in data)
        && hasAuthoritativeTutorName(data)
        && get(
          /databases/$(database)/documents/assignments/$(data.assignmentId)
        ).data.studentId == data.studentId
        && get(
          /databases/$(database)/documents/assignments/$(data.assignmentId)
        ).data.status == "open";
    }

    // Read an individual existing request
    allow get: if isSignedIn()
      && hasValidParticipants(resource.data)
      && isParticipant(resource.data);

    // Query requests involving the logged-in user
    allow list: if isSignedIn()
      && (
        resource.data.senderId == request.auth.uid
        || resource.data.recipientId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
      );

    allow create: if isSignedIn()
      && hasValidParticipants(request.resource.data)
      && request.auth.uid == request.resource.data.senderId
      && request.resource.data.status == "pending"
      && hasAllowedRequestFields(request.resource.data)
      && hasFinishedProfile()
      && (
        isDirectTutorRequest(matchId, request.resource.data)
        || isAssignmentApplication(matchId, request.resource.data)
      )
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

    // Only the recipient can accept or reject a pending request.
    // Authoritative student names are added when accepting a tutor's application.
    // senderId, recipientId, studentId and tutorId must remain unchanged.
    allow update: if isSignedIn()
      && request.auth.uid == resource.data.recipientId
      && resource.data.status == "pending"
      && request.resource.data.status in ["accepted", "rejected"]
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "status",
          "updatedAt",
          "studentFirstName",
          "studentLastName"
        ])
      && hasValidAnswerNameChanges()
      && request.resource.data.updatedAt == request.time;

    function hasValidAnswerNameChanges() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return request.resource.data.status == "rejected"
        ? !changed.hasAny(["studentFirstName", "studentLastName"])
        : resource.data.senderId == resource.data.studentId
          ? !changed.hasAny(["studentFirstName", "studentLastName"])
          : request.auth.uid == resource.data.studentId
            && changed.hasAll(["studentFirstName", "studentLastName"])
            && hasAuthoritativeStudentName(request.resource.data);
    }

    // FR-024: sending a message also updates the match's lastMessage, so
    // All Matches can show the preview and sort by the newest message.
    // Either user in an accepted match can do this, and nothing else
    // about the match can change.
    allow update: if isSignedIn()
      && hasValidParticipants(resource.data)
      && isParticipant(resource.data)
      && resource.data.status == "accepted"
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["lastMessage", "updatedAt"])
      && isValidLastMessage(request.resource.data.lastMessage)
      && lastMessageHasMatchingMessage(request.resource.data.lastMessage)
      && request.resource.data.updatedAt == request.time;

    // FR-024: opening a chat saves when each user last read it, so the
    // other person sees a double tick. Each user can only set their own
    // time, to now, and nothing else about the match can change.
    allow update: if isSignedIn()
      && hasValidParticipants(resource.data)
      && isParticipant(resource.data)
      && resource.data.status == "accepted"
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["readAt", "updatedAt"])
      && request.resource.data.readAt is map
      && request.resource.data.readAt
        .diff(resource.data.get("readAt", {}))
        .affectedKeys()
        .hasOnly([request.auth.uid])
      && request.resource.data.readAt[request.auth.uid] == request.time
      && request.resource.data.updatedAt == request.time;

    function isValidMessageText(text) {
      return text is string
        && text.size() > 0
        && text.size() <= 1000
        && text.matches(".*\\S.*");
    }

    function isValidLastMessage(lastMessage) {
      return lastMessage is map
        && lastMessage.keys().hasOnly([
          "messageId",
          "text",
          "senderId",
          "sentAt"
        ])
        && lastMessage.keys().hasAll([
          "messageId",
          "text",
          "senderId",
          "sentAt"
        ])
        && lastMessage.messageId is string
        && lastMessage.messageId.size() > 0
        && isValidMessageText(lastMessage.text)
        && lastMessage.senderId == request.auth.uid
        && lastMessage.sentAt == request.time;
    }

    function lastMessageHasMatchingMessage(lastMessage) {
      let messagePath = /databases/$(database)/documents/matches/$(matchId)/messages/$(lastMessage.messageId);
      let message = getAfter(messagePath).data;
      return existsAfter(messagePath)
        && message.senderId == lastMessage.senderId
        && message.text == lastMessage.text
        && message.sentAt == lastMessage.sentAt;
    }

    // Prevent users from deleting requests or accepted matches.
    // Rejected requests are retained with status "rejected".
    allow delete: if false;

    // FR-024 and story 33: chat messages. Only the two users in the match
    // can read or send them, and only once the match is accepted.
    // Messages can't be edited or deleted. No attachments: text only.
    match /messages/{messageId} {
      function isInAcceptedMatch() {
        let matchData = get(/databases/$(database)/documents/matches/$(matchId)).data;
        return hasValidParticipants(matchData)
          && isParticipant(matchData)
          && matchData.status == "accepted";
      }

      function parentHasMatchingLastMessage() {
        let parent = getAfter(
          /databases/$(database)/documents/matches/$(matchId)
        ).data;
        return parent.status == "accepted"
          && parent.lastMessage.messageId == messageId
          && parent.lastMessage.senderId == request.resource.data.senderId
          && parent.lastMessage.text == request.resource.data.text
          && parent.lastMessage.sentAt == request.resource.data.sentAt;
      }

      allow read: if isSignedIn() && isInAcceptedMatch();

      allow create: if isSignedIn()
        && isInAcceptedMatch()
        && request.resource.data.keys().hasOnly(["senderId", "text", "sentAt"])
        && request.resource.data.senderId == request.auth.uid
        && isValidMessageText(request.resource.data.text)
        && request.resource.data.sentAt == request.time
        && parentHasMatchingLastMessage();

      allow update, delete: if false;
    }
  }

    // Private account details, including contact details.
    match /users/{uid} {
      function hasValidProfileFields() {
        let data = request.resource.data;
        return (!("phone" in data) || (data.phone is string && data.phone.size() <= 20))
          && (!("location" in data) || data.location is string)
          && (!("level" in data) || data.level is string)
          && (!("subjects" in data) || data.subjects is list)
          && (!("lessonModes" in data) || data.lessonModes is list)
          && (!("availability" in data) || data.availability is list)
          && (!("teachingStyles" in data) || data.teachingStyles is list)
          && (!("budgetMin" in data) || data.budgetMin is number)
          && (!("budgetMax" in data) || data.budgetMax is number);
      }

      allow create: if isDocumentOwner(uid)
        && request.resource.data.role
          in ["student", "tutor"]

        && request.resource.data.keys().hasAll([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.onboardingComplete
          is bool

        && request.resource.data.email
          == request.auth.token.email

        && request.resource.data.onboardingComplete
          == false

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow read: if isDocumentOwner(uid);

      allow update: if isDocumentOwner(uid)
        && request.resource.data.role
          == resource.data.role

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "onboardingComplete",
            "phone",
            "location",
            "level",
            "subjects",
            "lessonModes",
            "availability",
            "teachingStyles",
            "budgetMin",
            "budgetMax",
            "updatedAt"
          ])

        && hasValidProfileFields()

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if false;
    }

    // Public tutor info shown on Find Tutors (FR-008).
    // No contact details here. Document ID is the tutor's uid.
    match /tutorProfiles/{uid} {
      function hasValidTutorProfileFields() {
        return request.resource.data.keys().hasAll([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "rating",
            "bio",
            "qualification",
            "yearsOfExperience",
            "lessonModes",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.subjects is list
          && request.resource.data.levels is list
          && request.resource.data.location is string
          && request.resource.data.hourlyRate is number
          && request.resource.data.availability is list
          && request.resource.data.teachingStyles is list

          // Optional fields: checked only if present.
          && (!("rating" in request.resource.data) || (
            request.resource.data.rating is number
            && request.resource.data.rating > 0
            && request.resource.data.rating <= 5
          ))
          && request.resource.data.get("qualification", "")
            is string
          && request.resource.data.get("yearsOfExperience", 0)
            is number
          && request.resource.data.get("bio", "")
            is string
          && request.resource.data.get("lessonModes", [])
            is list;
      }

      allow read: if isSignedIn();

      allow create: if isDocumentOwner(uid)
        && currentUserRole() == "tutor"
        && hasValidTutorProfileFields()

        // Only the approved seed accounts can create a rated profile.
        && (!("rating" in request.resource.data)
          || isSeededDemoAccount())

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isDocumentOwner(uid)
        && hasValidTutorProfileFields()

        // Seeded ratings are fixed prototype data. Profile editing may
        // preserve one, but cannot add, remove, or change it.
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(["rating"])

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if isDocumentOwner(uid);
    }

    // Post Assignment (FR-018, FR-019) and Find Assignments (FR-014, FR-015).
    match /assignments/{assignmentId} {
      function hasValidAssignmentFields() {
        return request.resource.data.keys().hasAll([
            "studentId",
            "subject",
            "level",
            "location",
            "learningMode",
            "minimumRate",
            "maximumRate",
            "preferredDay",
            "preferredTimeSlot",
            "teachingStyle",
            "additionalDetails",
            "status",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "studentId",
            "subject",
            "level",
            "location",
            "learningMode",
            "minimumRate",
            "maximumRate",
            "preferredDay",
            "preferredTimeSlot",
            "teachingStyle",
            "additionalDetails",
            "status",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.studentId is string
          && request.resource.data.subject is string
          && request.resource.data.level is string
          && request.resource.data.location is string
          && request.resource.data.learningMode
            in ["In-person", "Online", "Either"]

          && request.resource.data.minimumRate is number
          && request.resource.data.minimumRate > 0

          && request.resource.data.maximumRate is number
          && request.resource.data.maximumRate
            >= request.resource.data.minimumRate

          && request.resource.data.preferredDay is string
          && request.resource.data.preferredTimeSlot is string
          && request.resource.data.teachingStyle is string
          && request.resource.data.additionalDetails is string

          && request.resource.data.status
            in ["open", "matched", "closed"];
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && currentUserRole() == "student"

        && request.resource.data.studentId
          == request.auth.uid

        && request.resource.data.status == "open"
        && hasValidAssignmentFields()

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isSignedIn()
        && resource.data.studentId
          == request.auth.uid

        && request.resource.data.studentId
          == resource.data.studentId

        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(["status", "updatedAt"])

        && (
          (
            resource.data.status == "open"
            && request.resource.data.status in ["matched", "closed"]
          )
          || (
            resource.data.status == "matched"
            && request.resource.data.status == "closed"
          )
        )

        && request.resource.data.updatedAt
          == request.time;

      // Keep references from applications and matches valid. Archive by moving
      // to "closed" instead of deleting the assignment document.
      allow delete: if false;
    }
  }
}
