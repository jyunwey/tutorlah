rules_version = '2';

// Firestore security rules (NFR-007). See docs/data-model.md.
//
// Any collection without a rule here is blocked.
// Add a rule before using a new collection.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDocumentOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function currentUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    // Demo tutors created by scripts/seedTutors.js.
    function isSeededDemoAccount() {
      return request.auth.token.email
        .matches(".*@tutorlah[.]test$");
    }

      match /matches/{matchId} {
    function hasRequiredIds(data) {
      return data.keys().hasAll([
        "senderId",
        "recipientId",
        "studentId",
        "tutorId"
      ]);
    }

    function hasValidIdTypes(data) {
      return data.senderId is string
        && data.recipientId is string
        && data.studentId is string
        && data.tutorId is string;
    }

    function hasValidParticipants(data) {
      return hasRequiredIds(data)
        && hasValidIdTypes(data)
        && data.studentId != data.tutorId
        && (
          (
            data.senderId == data.studentId
            && data.recipientId == data.tutorId
          )
          ||
          (
            data.senderId == data.tutorId
            && data.recipientId == data.studentId
          )
        );
    }

    function isParticipant(data) {
      return isSignedIn()
        && (
          request.auth.uid == data.studentId
          || request.auth.uid == data.tutorId
          || request.auth.uid == data.senderId
          || request.auth.uid == data.recipientId
        );
    }

    function hasAllowedRequestFields(data) {
      return data.keys().hasOnly([
          "status",
          "senderId",
          "recipientId",
          "studentId",
          "tutorId",
          "assignmentId",
          "studentFirstName",
          "studentLastName",
          "tutorFirstName",
          "tutorLastName",
          "createdAt",
          "updatedAt"
        ])
        && data.tutorFirstName is string
        && data.tutorLastName is string
        && data.get("studentFirstName", "") is string
        && data.get("studentLastName", "") is string;
    }

    function hasFinishedProfile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.onboardingComplete == true;
    }

    function isDirectTutorRequest(id, data) {
      return !("assignmentId" in data)
        && data.senderId == data.studentId
        && id == data.studentId + "_" + data.tutorId
        && currentUserRole() == "student"
        && exists(
          /databases/$(database)/documents/tutorProfiles/$(data.tutorId)
        );
    }

    function isAssignmentApplication(id, data) {
      return "assignmentId" in data
        && data.assignmentId is string
        && data.senderId == data.tutorId
        && id == data.assignmentId + "_" + data.tutorId
        && currentUserRole() == "tutor"
        && get(
          /databases/$(database)/documents/assignments/$(data.assignmentId)
        ).data.studentId == data.studentId
        && get(
          /databases/$(database)/documents/assignments/$(data.assignmentId)
        ).data.status == "open";
    }

    function isAcceptedMatchParticipant(id) {
      let parent = get(
        /databases/$(database)/documents/matches/$(id)
      ).data;
      return hasValidParticipants(parent)
        && isParticipant(parent)
        && parent.status == "accepted";
    }

    // Read an individual existing request
    allow get: if isSignedIn()
      && hasValidParticipants(resource.data)
      && isParticipant(resource.data);

    // Query requests involving the logged-in user
    allow list: if isSignedIn()
      && (
        resource.data.senderId == request.auth.uid
        || resource.data.recipientId == request.auth.uid
        || resource.data.studentId == request.auth.uid
        || resource.data.tutorId == request.auth.uid
      );

    allow create: if isSignedIn()
      && hasValidParticipants(request.resource.data)
      && request.auth.uid == request.resource.data.senderId
      && request.resource.data.status == "pending"
      && hasAllowedRequestFields(request.resource.data)
      && hasFinishedProfile()
      && (
        isDirectTutorRequest(matchId, request.resource.data)
        || isAssignmentApplication(matchId, request.resource.data)
      )
      && request.resource.data.createdAt == request.time
      && request.resource.data.updatedAt == request.time;

    // Only the recipient can accept or reject a pending request.
    // Student names may also be added when accepting a tutor's application (FR-021).
    // senderId, recipientId, studentId and tutorId must remain unchanged.
    allow update: if isSignedIn()
      && request.auth.uid == resource.data.recipientId
      && resource.data.status == "pending"
      && request.resource.data.status in ["accepted", "rejected"]
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "status",
          "updatedAt",
          "studentFirstName",
          "studentLastName"
        ])
      && (
        !request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasAny(["studentFirstName", "studentLastName"])
        || (
          request.auth.uid == resource.data.studentId
          && request.resource.data.status == "accepted"
          && request.resource.data.studentFirstName is string
          && request.resource.data.studentLastName is string
        )
      )
      && request.resource.data.updatedAt == request.time;

    allow update: if isSignedIn()
      && hasValidParticipants(resource.data)
      && isParticipant(resource.data)
      && resource.data.status == "accepted"
      && request.resource.data.status == "accepted"
      && request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly(["lastMessage", "updatedAt"])
      && request.resource.data.lastMessage.keys()
        .hasAll(["text", "senderId", "sentAt"])
      && request.resource.data.lastMessage.keys()
        .hasOnly(["text", "senderId", "sentAt"])
      && request.resource.data.lastMessage.text is string
      && request.resource.data.lastMessage.text.size() > 0
      && request.resource.data.lastMessage.text.size() <= 1000
      && request.resource.data.lastMessage.senderId == request.auth.uid
      && request.resource.data.lastMessage.sentAt == request.time
      && request.resource.data.updatedAt == request.time;

    // Prevent users from deleting requests or accepted matches.
    // Rejected requests are retained with status "rejected".
    allow delete: if false;

    match /messages/{messageId} {
      allow read: if isSignedIn()
        && isAcceptedMatchParticipant(matchId);

      allow create: if isSignedIn()
        && isAcceptedMatchParticipant(matchId)
        && request.resource.data.keys()
          .hasAll(["senderId", "text", "sentAt"])
        && request.resource.data.keys()
          .hasOnly(["senderId", "text", "sentAt"])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.sentAt == request.time;

      allow update, delete: if false;
    }
  }

    // Private account details, including contact details.
    match /users/{uid} {
      function hasValidProfileFields() {
        let data = request.resource.data;
        return (!("phone" in data) || (data.phone is string && data.phone.size() <= 20))
          && (!("location" in data) || data.location is string)
          && (!("level" in data) || data.level is string)
          && (!("subjects" in data) || data.subjects is list)
          && (!("lessonModes" in data) || data.lessonModes is list)
          && (!("availability" in data) || data.availability is list)
          && (!("teachingStyles" in data) || data.teachingStyles is list)
          && (!("budgetMin" in data) || data.budgetMin is number)
          && (!("budgetMax" in data) || data.budgetMax is number);
      }

      allow create: if isDocumentOwner(uid)
        && request.resource.data.role
          in ["student", "tutor"]

        && request.resource.data.keys().hasAll([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.onboardingComplete
          is bool

        && request.resource.data.email
          == request.auth.token.email

        && request.resource.data.onboardingComplete
          == false

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow read: if isDocumentOwner(uid);

      allow update: if isDocumentOwner(uid)
        && request.resource.data.role
          == resource.data.role

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "onboardingComplete",
            "phone",
            "location",
            "level",
            "subjects",
            "lessonModes",
            "availability",
            "teachingStyles",
            "budgetMin",
            "budgetMax",
            "updatedAt"
          ])

        && hasValidProfileFields()

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if false;
    }

    // Public tutor info shown on Find Tutors (FR-008).
    // No contact details here. Document ID is the tutor's uid.
    match /tutorProfiles/{uid} {
      function hasValidTutorProfileFields() {
        return request.resource.data.keys().hasAll([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "rating",
            "bio",
            "qualification",
            "yearsOfExperience",
            "lessonModes",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.subjects is list
          && request.resource.data.levels is list
          && request.resource.data.location is string
          && request.resource.data.hourlyRate is number
          && request.resource.data.availability is list
          && request.resource.data.teachingStyles is list

          // Optional fields: checked only if present.
          && request.resource.data.get("rating", 0)
            is number
          && request.resource.data.get("qualification", "")
            is string
          && request.resource.data.get("yearsOfExperience", 0)
            is number
          && request.resource.data.get("bio", "")
            is string
          && request.resource.data.get("lessonModes", [])
            is list

          // Ratings are seeded demo values (Refined FR-008), so only the
          // seeded @tutorlah.test accounts may have one. Real tutors can't
          // give themselves a rating; the app shows them as "New tutor".
          && (!("rating" in request.resource.data)
            || isSeededDemoAccount());
      }

      allow read: if isSignedIn();

      allow create: if isDocumentOwner(uid)
        && currentUserRole() == "tutor"
        && hasValidTutorProfileFields()

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isDocumentOwner(uid)
        && hasValidTutorProfileFields()

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if isDocumentOwner(uid);
    }

    // Post Assignment (FR-018, FR-019) and Find Assignments (FR-014, FR-015).
    // TODO: add field checks once the Post Assignment fields are final.
    match /assignments/{assignmentId} {
      function hasValidAssignmentFields() {
        return request.resource.data.keys().hasAll([
            "studentId",
            "subject",
            "level",
            "location",
            "learningMode",
            "minimumRate",
            "maximumRate",
            "preferredDay",
            "preferredTimeSlot",
            "teachingStyle",
            "additionalDetails",
            "status",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "studentId",
            "subject",
            "level",
            "location",
            "learningMode",
            "minimumRate",
            "maximumRate",
            "preferredDay",
            "preferredTimeSlot",
            "teachingStyle",
            "additionalDetails",
            "status",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.studentId is string
          && request.resource.data.subject is string
          && request.resource.data.level is string
          && request.resource.data.location is string
          && request.resource.data.learningMode
            in ["In-person", "Online", "Either"]

          && request.resource.data.minimumRate is number
          && request.resource.data.minimumRate > 0

          && request.resource.data.maximumRate is number
          && request.resource.data.maximumRate
            >= request.resource.data.minimumRate

          && request.resource.data.preferredDay is string
          && request.resource.data.preferredTimeSlot is string
          && request.resource.data.teachingStyle is string
          && request.resource.data.additionalDetails is string

          && request.resource.data.status
            in ["open", "matched", "closed"];
      }

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && currentUserRole() == "student"

        && request.resource.data.studentId
          == request.auth.uid

        && request.resource.data.status == "open"
        && hasValidAssignmentFields()

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isSignedIn()
        && resource.data.studentId
          == request.auth.uid

        && request.resource.data.studentId
          == resource.data.studentId

        && request.resource.data.createdAt
          == resource.data.createdAt

        && hasValidAssignmentFields()

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if isSignedIn()
        && resource.data.studentId
          == request.auth.uid;
    }
  }
}
