rules_version = '2';

// Firestore security rules (NFR-007). See docs/data-model.md.
//
// Any collection without a rule here is blocked.
// Add a rule before using a new collection.
// TODO (Sprint 2): rules for requests, matches and messages.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDocumentOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function currentUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    // Private account details, including contact details.
    match /users/{uid} {
      function hasValidProfileFields() {
        let data = request.resource.data;
        return (!("phone" in data) || (data.phone is string && data.phone.size() <= 20))
          && (!("location" in data) || data.location is string)
          && (!("level" in data) || data.level is string)
          && (!("subjects" in data) || data.subjects is list)
          && (!("lessonModes" in data) || data.lessonModes is list)
          && (!("availability" in data) || data.availability is list)
          && (!("teachingStyles" in data) || data.teachingStyles is list)
          && (!("budgetMin" in data) || data.budgetMin is number)
          && (!("budgetMax" in data) || data.budgetMax is number);
      }

      allow create: if isDocumentOwner(uid)
        && request.resource.data.role
          in ["student", "tutor"]

        && request.resource.data.keys().hasAll([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.keys().hasOnly([
          "role",
          "firstName",
          "lastName",
          "email",
          "onboardingComplete",
          "createdAt",
          "updatedAt"
        ])

        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.email is string
        && request.resource.data.onboardingComplete
          is bool

        && request.resource.data.email
          == request.auth.token.email

        && request.resource.data.onboardingComplete
          == false

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow read: if isDocumentOwner(uid);

      allow update: if isDocumentOwner(uid)
        && request.resource.data.role
          == resource.data.role

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "onboardingComplete",
            "phone",
            "location",
            "level",
            "subjects",
            "lessonModes",
            "availability",
            "teachingStyles",
            "budgetMin",
            "budgetMax",
            "updatedAt"
          ])

        && hasValidProfileFields()

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if false;
    }

    // Public tutor info shown on Find Tutors (FR-008).
    // No contact details here. Document ID is the tutor's uid.
    match /tutorProfiles/{uid} {
      function hasValidTutorProfileFields() {
        return request.resource.data.keys().hasAll([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "rating",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.keys().hasOnly([
            "firstName",
            "lastName",
            "subjects",
            "levels",
            "location",
            "hourlyRate",
            "availability",
            "teachingStyles",
            "rating",
            "bio",
            "lessonModes",
            "qualification",
            "experienceYears",
            "createdAt",
            "updatedAt"
          ])

          && request.resource.data.firstName is string
          && request.resource.data.lastName is string
          && request.resource.data.subjects is list
          && request.resource.data.levels is list
          && request.resource.data.location is string
          && request.resource.data.hourlyRate is number
          && request.resource.data.availability is list
          && request.resource.data.teachingStyles is list
          && request.resource.data.rating is number
          && (!("bio" in request.resource.data)
            || request.resource.data.bio is string)
          && (!("lessonModes" in request.resource.data)
            || request.resource.data.lessonModes is list)
          && (!("qualification" in request.resource.data)
            || request.resource.data.qualification is string)
          && (!("experienceYears" in request.resource.data)
            || request.resource.data.experienceYears is number);
      }

      allow read: if isSignedIn();

      allow create: if isDocumentOwner(uid)
        && currentUserRole() == "tutor"
        && hasValidTutorProfileFields()

        && request.resource.data.createdAt
          == request.time

        && request.resource.data.updatedAt
          == request.time;

      allow update: if isDocumentOwner(uid)
        && hasValidTutorProfileFields()

        && request.resource.data.createdAt
          == resource.data.createdAt

        && request.resource.data.updatedAt
          == request.time;

      allow delete: if isDocumentOwner(uid);
    }

    // Post Assignment (FR-018, FR-019) and Find Assignments (FR-014, FR-015).
    // TODO: add field checks once the Post Assignment fields are final.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && currentUserRole() == "student"
        && request.resource.data.studentId
          == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.studentId
          == request.auth.uid

        && request.resource.data.studentId
          == resource.data.studentId;

      allow delete: if isSignedIn()
        && resource.data.studentId
          == request.auth.uid;
    }
  }
}
